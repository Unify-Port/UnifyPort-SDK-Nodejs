{
  "name": "unifyport-sdk-node-workspace",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "UnifyPort Node.js SDK、MCP Server 与公开协作 skill 的工作区。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unify-Port/UnifyPort-SDK-Nodejs.git"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "check": "pnpm public:check && pnpm contracts:lint && pnpm generate:check && pnpm docs:check && pnpm lint && pnpm format:check && pnpm test && pnpm typecheck && pnpm build && pnpm package:check",
    "clean": "tsx scripts/clean.ts",
    "contracts:lint": "redocly lint contracts/device.openapi.yaml",
    "docs:check": "tsx scripts/check-docs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "tsx scripts/generate.ts",
    "generate:check": "tsx scripts/check-generated.ts",
    "lint": "pnpm --filter @unifyport/sdk-node build && eslint .",
    "package:check": "tsx scripts/check-packages.ts",
    "public:check": "tsx scripts/check-public.ts",
    "test": "pnpm --filter @unifyport/sdk-node build && vitest run --coverage",
    "test:watch": "pnpm --filter @unifyport/sdk-node build && vitest",
    "typecheck": "tsc -p tsconfig.tooling.json --noEmit && pnpm -r typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.39.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "jiti": "2.7.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.5",
    "publint": "0.3.21",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
