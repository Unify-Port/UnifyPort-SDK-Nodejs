{
  "name": "@unifyport/sdk-node",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Type-safe Node.js SDK for the UnifyPort Device API.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unify-Port/UnifyPort-SDK-Nodejs.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://www.unifyport.ai",
  "bugs": {
    "url": "https://github.com/Unify-Port/UnifyPort-SDK-Nodejs/issues"
  },
  "keywords": [
    "unifyport",
    "sdk",
    "device-api",
    "nodejs",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./device": {
      "types": "./dist/device/index.d.ts",
      "import": "./dist/device/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "openapi-typescript-helpers": "0.1.0"
  }
}
